FROM rust:1.94.1-alpine3.23 AS builder
RUN apk add musl-dev openssl-dev openssl-libs-static

WORKDIR /app

COPY . .

RUN cargo build --release --locked --features s3,mimalloc --bin dicom-rst

FROM gcr.io/distroless/cc-debian12 AS runtime
COPY --from=builder /app/target/release/dicom-rst /
# licenses.html is generated by the docker-publish workflow, see about.toml
COPY LICENSE licenses.html /usr/share/doc/dicom-rst/
ENTRYPOINT ["./dicom-rst"]
